# Supabase — kendi projenden al (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Turnstile (CAPTCHA) — opsiyonel ama public launch için önerilir.
# Boşsa CAPTCHA render edilmez. Supabase Auth > Bot & Abuse'da da açılmalı.
VITE_TURNSTILE_SITE_KEY=

# Sentry hata izleme — opsiyonel. Boşsa izleme kapalı.
VITE_SENTRY_DSN=
